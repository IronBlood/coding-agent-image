FROM node:24-trixie-slim

# The user-facing image reuses host UID/GID values, commonly 1000:1000.
RUN userdel --remove node

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    git \
    sed \
    gawk \
    ripgrep \
    fd-find \
    ca-certificates \
    curl \
  && ln -s /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://claude.ai/install.sh | bash

RUN mkdir -p /opt/claude-code/bin \
  && install -m 0755 "$(readlink -f /root/.local/bin/claude)" /opt/claude-code/bin/claude \
  && printf '%s\n' \
    '#!/bin/sh' \
    'export DISABLE_AUTOUPDATER=1' \
    'exec /opt/claude-code/bin/claude "$@"' \
    > /usr/local/bin/claude \
  && chmod 0755 /usr/local/bin/claude

RUN which claude \
  && claude --version

RUN npm install -g \
    --ignore-scripts \
    --no-fund \
    --no-audit \
    --loglevel=error \
    --progress=false \
    @earendil-works/pi-coding-agent \
  && command -v pi \
  && pi --version

# Keep install scripts enabled: GitHub Copilot CLI requires them for its npm installation.
RUN npm install -g \
    --no-fund \
    --no-audit \
    --loglevel=error \
    --progress=false \
    @openai/codex \
    @github/copilot \
    @google/gemini-cli \
  && command -v codex \
  && codex --version \
  && command -v copilot \
  && copilot --version \
  && command -v gemini \
  && gemini --version
