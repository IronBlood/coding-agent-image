FROM node:24-trixie-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:${PATH}

# The user-facing image reuses host UID/GID values, commonly 1000:1000.
RUN userdel --remove node

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    git \
    sed \
    gawk \
    ripgrep \
    fd-find \
    build-essential \
    python3 \
    python3-venv \
    python-is-python3 \
    ca-certificates \
    curl \
  && ln -s /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
    | CARGO_HOME=/usr/local/cargo sh -s -- -y --profile minimal --default-toolchain stable \
  && chmod -R a+rX /usr/local/cargo /usr/local/rustup \
  && rustc --version \
  && cargo --version

RUN command -v python \
  && python --version \
  && command -v uv \
  && uv --version \
  && command -v uvx \
  && uvx --version

RUN curl -fsSL https://claude.ai/install.sh | bash

RUN mkdir -p /opt/claude-code/bin \
  && install -m 0755 "$(readlink -f /root/.local/bin/claude)" /opt/claude-code/bin/claude \
  && printf '%s\n' \
    '#!/bin/sh' \
    'export DISABLE_AUTOUPDATER=1' \
    'exec /opt/claude-code/bin/claude "$@"' \
    > /usr/local/bin/claude \
  && chmod 0755 /usr/local/bin/claude

RUN which claude \
  && claude --version

RUN npm install -g \
    --ignore-scripts \
    --no-fund \
    --no-audit \
    --loglevel=error \
    --progress=false \
    @earendil-works/pi-coding-agent \
  && npm cache clean --force \
  && rm -rf /root/.npm \
  && command -v pi \
  && pi --version

RUN npm install -g \
    --no-fund \
    --no-audit \
    --loglevel=error \
    --progress=false \
    @openai/codex \
    @google/gemini-cli \
  && npm cache clean --force \
  && rm -rf /root/.npm \
  && command -v codex \
  && codex --version \
  && command -v gemini \
  && gemini --version
